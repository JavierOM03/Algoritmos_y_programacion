Algoritmo TiposDeInstrucciones
	// Instrucciones de Declaracion
	Definir a, b, resultado Como Entero
	
	//  Instruccion de Entrada
	Leer a
	
	// Instrucciones de Asignacion
	b <- 10
	Si resultado <- a + b
	
	// Instruccion de Salida 
		Escribir "El numero supera el limite."
	FinSi
	FinAlgoritmo
